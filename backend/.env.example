# Umi Backend Configuration
PORT=10201

# --- Hermes Agent (sidecar on port 8642) ---
HERMES_API_KEY=
HERMES_API_URL=https://api.fireworks.ai/inference/v1
HERMES_MODEL=accounts/fireworks/routers/kimi-k2p5-turbo
HERMES_PORT=8642

# --- HuggingFace (needed for Chatterbox model download) ---
HF_TOKEN=

# --- Chatterbox TTS (local sidecar) ---
CHATTERBOX_TTS_URL=http://127.0.0.1:10202
CHATTERBOX_DEFAULT_VOICE_ID=cristina

# --- Kokoro TTS (fast local fallback) ---
KOKORO_TTS_URL=http://127.0.0.1:10203

# --- ElevenLabs TTS fallback ---
TTS_API_KEY=

# --- Fallback: direct LLM if Hermes is not running ---
# LLM_API_KEY=
# LLM_API_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- SQLite ---
# DB_PATH=/tmp/umi.db
